{
	"manifest_version": 3,

	"name": "Quick Translate",
	"description": "Translate, Dictionary with Google and Thesaurus",
	"version": "3.0",
	"background": {
		"service_worker": "background.js"
	},

	"permissions": ["activeTab", "scripting", "storage"],
	"host_permissions": ["https://thesaurus.altervista.org/*"],
	"action": {
		"default_icon": "translation.png",
		"default_title": "Translate selected text"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": false
	},
	"icons": {
      "128": "translation.png",
      "16": "translation.png",
      "32": "translation.png",
      "48": "translation.png"
   }
}